{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "alwaysShowTabs": true,
    "copyOnSelect": false,
    "copyFormatting": "none",
    "defaultProfile": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
    "initialCols": 140,
    "initialRows": 36,
    "showTabsInTitlebar": true,
    "useAcrylicInTabRow": true,
    "theme": "dark",
    "actions": [
        { "command": "find",                          "keys": "ctrl+shift+f" },
        { "command": "paste",                         "keys": "ctrl+v" },
        { "command": { "action": "splitPane", "split": "vertical" },   "keys": "alt+shift+plus" },
        { "command": { "action": "splitPane", "split": "horizontal" }, "keys": "alt+shift+-" },
        { "command": { "action": "newTab" },          "keys": "ctrl+t" },
        { "command": { "action": "closeTab" },        "keys": "ctrl+w" }
    ],
    "profiles": {
        "defaults": {
            "font": {
                "face": "FiraCode Nerd Font Mono",
                "size": 11
            },
            "padding": "10",
            "useAcrylic": true,
            "opacity": 92,
            "antialiasingMode": "cleartype",
            "scrollbarState": "hidden",
            "cursorShape": "filledBox"
        },
        "list": [
            {
                "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
                "name": "PowerShell",
                "source": "Windows.Terminal.PowershellCore",
                "commandline": "pwsh.exe -NoLogo",
                "icon": "ms-appx:///ProfileIcons/{61c54bbd-c2c6-5271-96e7-009a87ff44bf}.png",
                "colorScheme": "One Half Dark",
                "startingDirectory": "%USERPROFILE%\\OneDrive\\Documents\\03_Projets_Code"
            },
            {
                "guid": "{2c4de342-38b7-51cf-b940-2309a097f518}",
                "name": "Ubuntu (WSL)",
                "source": "Windows.Terminal.Wsl",
                "colorScheme": "Campbell Powershell",
                "startingDirectory": "//wsl$/Ubuntu/home/tomle"
            },
            {
                "guid": "{0caa0dad-35be-5f56-a8ff-afceeeaa6101}",
                "name": "Command Prompt",
                "commandline": "%SystemRoot%\\System32\\cmd.exe",
                "hidden": false,
                "colorScheme": "Vintage"
            },
            {
                "guid": "{b453ae62-4e3d-5e58-b989-0a998ec441b8}",
                "name": "Azure Cloud Shell",
                "source": "Windows.Terminal.Azure",
                "hidden": true
            }
        ]
    },
    "schemes": [
        {
            "name": "One Half Dark",
            "background": "#282C34",
            "foreground": "#DCDFE4",
            "black": "#282C34", "blue": "#61AFEF", "cyan": "#56B6C2", "green": "#98C379",
            "purple": "#C678DD", "red": "#E06C75", "white": "#DCDFE4", "yellow": "#E5C07B",
            "brightBlack": "#5A6374", "brightBlue": "#61AFEF", "brightCyan": "#56B6C2",
            "brightGreen": "#98C379", "brightPurple": "#C678DD", "brightRed": "#E06C75",
            "brightWhite": "#DCDFE4", "brightYellow": "#E5C07B",
            "cursorColor": "#FFFFFF", "selectionBackground": "#3E4452"
        }
    ]
}
